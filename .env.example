# Kopyala: cp .env.example .env   (Expo .env'i otomatik okur; değişince Metro'yu yeniden başlat)
# Veri kaynağı: mock | firebase | supabase
EXPO_PUBLIC_DATA_SOURCE=mock

# Firebase (Konsol > Proje ayarları > Web uygulaması)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google ile giriş (Firebase > Authentication > Sign-in method > Google > Web SDK configuration > Web client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Supabase (Project Settings > API). Yalnızca anon key; service_role ASLA buraya konmaz.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
