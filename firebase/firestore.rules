rules_version = '2';
// Barber Tedarikçi — Firestore kuralları.
// Her tedarikçi yalnızca kendi belgelerini görür; sipariş durumu yalnızca kurala uygun ilerler.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /suppliers/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.companyName is string
        && request.resource.data.email == request.auth.token.email;
      // Vergi no ve e-posta sonradan değiştirilemez.
      allow update: if isOwner(uid) && onlyChanged(['companyName', 'contactName', 'phone', 'city']);
      allow delete: if false;

      match /products/{id} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.price is number && request.resource.data.price > 0
          && request.resource.data.stock is int && request.resource.data.stock >= 0;
      }

      match /promotions/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.status == 'active'
          && request.resource.data.dailyBudget >= 50
          && request.resource.data.impressions == 0
          && request.resource.data.clicks == 0;
        // Gösterim/tıklama sayılarını istemci değiştiremez.
        allow update: if isOwner(uid) && onlyChanged(['status'])
          && request.resource.data.status in ['active', 'paused']
          && resource.data.status != 'ended';
      }
    }

    // Siparişleri salon uygulaması oluşturur; tedarikçi yalnızca durumunu ilerletir.
    match /orders/{id} {
      function validTransition(from, to) {
        return (from == 'new' && to in ['preparing', 'cancelled'])
          || (from == 'preparing' && to in ['shipped', 'cancelled'])
          || (from == 'shipped' && to == 'delivered');
      }
      allow read: if signedIn() && resource.data.supplierId == request.auth.uid;
      allow update: if signedIn() && resource.data.supplierId == request.auth.uid
        && onlyChanged(['status'])
        && validTransition(resource.data.status, request.resource.data.status);
      allow create, delete: if false;
    }
  }
}
